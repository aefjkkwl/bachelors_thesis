+        return 0
+
+    def _advance_sim_day_index(self) -> None:
+        current = self._get_sim_day_index()
+        next_index = (current + 1) % _SIM_WEEK_LENGTH_DAYS
+        with open(_SIM_STATE_FILE, "w", encoding="utf-8") as f:
+            json.dump({"day_index": next_index}, f)
+
+    def _load_custom_raw_history_window(
+        self, csv_path: str, window_start: datetime, window_end: datetime
+    ) -> list[dict[str, str]]:
+        df = pd.read_csv(csv_path)
+        col = "Carbon intensity gCO₂eq/kWh (direct)"
+        df["dt"] = pd.to_datetime(df["Datetime (UTC)"])
+        if df["dt"].dt.tz is None:
+            df["dt"] = df["dt"].dt.tz_localize("UTC")
+
+        mask = (df["dt"] >= window_start) & (df["dt"] < window_end)
+        filtered = df.loc[mask].sort_values("dt")
+
+        records = []
+        for _, row in filtered.iterrows():
+            dt_str = row["dt"].isoformat().replace("+00:00", "Z")
+            records.append({"datetime": dt_str, "carbonIntensity": str(row[col])})
+        return records
